          "sql": "WITH \"__m0\" AS (SELECT SUM(\"sales_orders\".\"sales_amount\") AS \"__value\" FROM \"sales_orders\" WHERE \"sales_orders\".\"order_date\" >= ? AND \"sales_orders\".\"order_date\" < ? AND \"sales_orders\".\"region\" = ?), \"__m1\" AS (SELECT COUNT(*) AS \"__value\" FROM \"sales_orders\" WHERE \"sales_orders\".\"order_date\" >= ? AND \"sales_orders\".\"order_date\" < ? AND \"sales_orders\".\"region\" = ?), \"__combined\" AS (SELECT \"__m0\".\"__value\" AS \"销售额\", \"__m1\".\"__value\" AS \"订单数\" FROM \"__m0\" CROSS JOIN \"__m1\") SELECT \"销售额\", \"订单数\" FROM \"__combined\" ORDER BY \"销售额\" DESC LIMIT ?",
